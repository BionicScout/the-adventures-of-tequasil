filters:
  and:
    - '!file.inFolder("Templates")'
    - file.hasTag("session-notes")
formulas:
  Title: if(title, file.asLink(title), file.asLink(file.name))
  Session Number: note["session-number"]
  Session Date: created.format("MM-DD-YYYY")
properties:
  formula.Session Number:
    displayName: Session
views:
  - type: table
    name: Sessions
    order:
      - formula.Session Number
      - formula.Session Date
      - formula.Title
    sort:
      - property: session-number
        direction: DESC
      - property: created
        direction: DESC
    columnSize:
      formula.Session Number: 80
      formula.Session Date: 112
      formula.Title: 499
